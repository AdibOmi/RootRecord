# --- Database ---
DATABASE_URL=postgresql+psycopg://rootrecord:rootrecord@db:5432/rootrecord
# Used by pytest; the database is created automatically if missing.
TEST_DATABASE_URL=postgresql+psycopg://rootrecord:rootrecord@db:5432/rootrecord_test

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# --- App ---
ENVIRONMENT=development
# Comma-separated origins allowed for CORS (only needed if the frontend is not proxied).
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=15

# --- Prescription extraction (Gemini, free tier) ---
# Get a free key at https://aistudio.google.com/apikey
# Without a key, photos are still stored and the record is filled in by hand.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Clinic details printed on prescription PDFs ---
CLINIC_NAME=Dental Clinic
CLINIC_ADDRESS=
CLINIC_PHONE=

# --- First-run admin account (created only if no admin exists) ---
BOOTSTRAP_ADMIN_EMAIL=admin@rootrecord.app
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_NAME=Clinic Admin
